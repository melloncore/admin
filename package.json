{
  "name": "admin",
  "version": "1.0.0",
  "private": true,
  "description": "Mellon Strata Core admin dashboard with backend authentication, analytics, and project inquiry management.",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "prepare": "husky install",
    "validate": "npm run lint && npm run typecheck && npm run test:ci",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "clsx": "2.1.1",
    "lucide-react": "0.408.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "29.5.12",
    "@types/node": "20.14.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "autoprefixer": "10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "9.1.0",
    "husky": "9.1.4",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "lint-staged": "15.2.7",
    "postcss": "8.4.40",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.5",
    "tailwindcss": "3.4.7",
    "typescript": "5.5.4",
    "wrangler": "^4.164.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
